# A matrix over Q: exact inverse, determinant and kernel through PARI.
A = Matrix([[2, 1, 1], [1, 3, 2], [1, 0, 0]])
print(det(A))
print(A^-1)
print(A * A^-1 == Matrix([[1, 0, 0], [0, 1, 0], [0, 0, 1]]))

# Solving A v = b exactly.
b = Matrix([4, 5, 6])
v = solve(A, b)
print(v.T, A*v == b)

# A singular matrix has a kernel.
B = Matrix([[1, 2, 3], [4, 5, 6], [7, 8, 9]])
print(rank(B), kernel(B)[0].T, hermite_form(B))
