# Finite fields: arithmetic in GF(p) and GF(p^k), done by PARI.
F7 = GF(7)
b = F7(3)
print(b + 5, b * 5, 1/b, b^6)

# GF(8) = F_2[a] / (an irreducible cubic); its generator a has order 7.
F = GF(8)
a = F.gen()
print(F.modulus(), [str(a^k) for k in range(8)])
print(a.order(), a^7 == 1)

# Polynomials over F_p: x^p - x is the product of all x - c.
sym x
print(factor(x^7 - x, modulus=7))
print(factor(x^4 + 1, modulus=3))
